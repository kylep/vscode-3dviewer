{
  "name": "vscode-3dviewer",
  "displayName": "3D Viewer (Reviewed Local)",
  "description": "Reviewed local read-only STL, OBJ and PLY previews; no network or export commands.",
  "version": "0.2.3",
  "publisher": "local-reviewed",
  "license": "MIT",
  "icon": "icon.png",
  "bugs": {
    "url": "https://github.com/kylep/vscode-3dviewer/issues"
  },
  "homepage": "https://github.com/kylep/vscode-3dviewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/kylep/vscode-3dviewer.git"
  },
  "galleryBanner": {
    "color": "#0075c3",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "keywords": [
    "vscode",
    "3d",
    "mesh",
    "viewer",
    "webgl",
    "3ds",
    "dae",
    "Collada",
    "fbx",
    "obj",
    "stl"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:3dviewer.viewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "3dviewer.viewer",
        "displayName": "3D Mesh Viewer (Reviewed Local)",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.stl"
          },
          {
            "filenamePattern": "*.obj"
          },
          {
            "filenamePattern": "*.ply"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && node scripts/build-webview.cjs",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "test:browser": "node scripts/browser-smoke.cjs",
    "package": "npm run compile && python3 scripts/build-vsix.py"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "typescript": "5.9.3",
    "esbuild": "0.28.2",
    "three": "0.186.1",
    "@playwright/test": "1.62.1"
  }
}
